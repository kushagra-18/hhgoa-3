# Application Environment Configuration

# App Settings
APP_NAME="HH Goa Face-to-Blockchain Pipeline"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Directory Paths
DATA_DIR=./data
MODELS_DIR=./models

# Database Configuration (PostgreSQL + pgvector)
# For Docker Compose: postgresql://postgres:postgrespassword@db:5432/face_verification_db
# For Local fallback: sqlite:///./data/pipeline.db or postgresql://postgres:postgrespassword@localhost:5432/face_verification_db
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/face_verification_db

# InsightFace Configuration
# Model packs: 'buffalo_l' (default, high accuracy), 'buffalo_sc', 'buffalo_m'
INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_DET_SIZE=640
INSIGHTFACE_CTX_ID=0

# Blockchain & EVM Configuration
# Set RPC_URL to local Anvil (http://localhost:8545), Sepolia, Polygon Amoy, or leave blank for internal simulated EVM
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_NETWORK_NAME=Local-EVM-Simulator
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=

# Web & Social Media Reverse Search APIs (Optional - falls back to realistic engine / web scraper)
SERPAPI_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
